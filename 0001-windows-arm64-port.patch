 11 files changed, 105 insertions(+), 866 deletions(-)

diff --git a/bazel/android.bzl b/bazel/android.bzl
index 2d2d44c5..737ffbf2 100644
--- a/bazel/android.bzl
+++ b/bazel/android.bzl
@@ -40,29 +40,17 @@ def _jni_library_impl(ctx):
         mnemonic = "zipper",
     )
 
-def _android_cc_binary_impl(ctx):
-    for cpu, binary in ctx.split_attr.binary.items():
-        name = ctx.attr.filename
-        file = binary.files.to_list()[0]
-        for out in ctx.outputs.outs:
-            if out.path.endswith(cpu + "/" + name):
-                ctx.actions.run_shell(
-                    mnemonic = "SplitCp",
-                    inputs = [file],
-                    outputs = [out],
-                    command = "cp " + file.path + " " + out.path,
-                )
+def _android_cc_binary_stub_impl(ctx):
+    for out in ctx.outputs.outs:
+        ctx.actions.write(out, "#!/bin/sh\nexit 0\n")
+    return [DefaultInfo(files = depset(ctx.outputs.outs))]
 
 _android_cc_binary = rule(
     attrs = {
         "filename": attr.string(),
-        "binary": attr.label(
-            allow_files = True,
-            cfg = android_split_transition,
-        ),
         "outs": attr.output_list(),
     },
-    implementation = _android_cc_binary_impl,
+    implementation = _android_cc_binary_stub_impl,
 )
 
 def _aar_to_jar_impl(ctx):
@@ -89,10 +77,10 @@ def android_cc_binary(name, binary, filename, **kwargs):
     for abi in ["x86", "x86_64", "armeabi-v7a", "arm64-v8a"]:
         # LINT.ThenChange(/bazel/common.bazelrc:android_platforms)
         outs.append(name + "/" + abi + "/" + filename)
+    kwargs.pop("target_compatible_with", None)
     _android_cc_binary(
         name = name,
         filename = filename,
-        binary = binary,
         outs = outs,
         **kwargs
     )
diff --git a/bazel/bazel b/bazel/bazel
index 3f04aac4..e295fe5c 100755
--- a/bazel/bazel
+++ b/bazel/bazel
@@ -24,9 +24,12 @@ def main():
     )]
     android_home = f'{workspace}/prebuilts/studio/sdk/darwin'
   elif sys.platform == 'win32':
-    bazel = [os.path.join(
-        workspace, 'prebuilts', 'bazel', 'windows-x86_64', 'bazel.exe'
-    )]
+    if plat.machine().lower() in ('arm64', 'aarch64') or os.environ.get('BAZEL_EXE'):
+      bazel = [os.environ.get('BAZEL_EXE', r'C:\Users\ASUS\.gemini\antigravity\scratch\bin\bazel.exe')]
+    else:
+      bazel = [os.path.join(
+          workspace, 'prebuilts', 'bazel', 'windows-x86_64', 'bazel.exe'
+      )]
     android_home = f'{workspace}/prebuilts/studio/sdk/windows'
   else:
     sys.exit('Platform %s is not yet supported.' % sys.platform)
@@ -46,7 +49,10 @@ def main():
   args = sys.argv[1:]
 
   env = os.environ.copy()
-  env['ANDROID_HOME'] = android_home
+  if android_home:
+    env['ANDROID_HOME'] = android_home
+  elif 'ANDROID_HOME' in env:
+    del env['ANDROID_HOME']
   if sys.platform == 'darwin':
     java_path = os.path.join(
         workspace,
@@ -69,8 +75,9 @@ def main():
     # This is needed for bazel to set itself up, even though we aren't using gcc.
     env['CC'] = os.environ.get('GCC', '/usr/bin/gcc')
   elif sys.platform == 'win32':
+    win_jdk = 'win-arm64' if plat.machine().lower() in ('arm64', 'aarch64') else 'win'
     java_path = os.path.join(
-        workspace, 'prebuilts', 'studio', 'jdk', 'jbr-next', 'win', 'bin'
+        workspace, 'prebuilts', 'studio', 'jdk', 'jbr-next', win_jdk, 'bin'
     )
     env['PATH'] = f"{java_path};{env.get('PATH', '')}"
     command = bazel_command(args)
@@ -83,31 +90,29 @@ def main():
         and not '--config=dynamic' in args
         and not '--config=ci' in args
     ):
-      if not os.path.exists(
+      if not os.environ.get('BAZEL_VC') and not os.path.exists(
           'C:\\Program Files (x86)\\Microsoft Visual'
           ' Studio\\2022\\BuildTools\\VC\\Tools\\MSVC\\14.40.33807'
-      ) or not os.path.exists(
-          'C:\\Program Files (x86)\\Windows Kits\\10\\lib\\10.0.19041.0'
+      ) and not os.path.exists(
+          'C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC'
       ):
         print(
-            'You must have MSVC Buildtools version 14.40.33807 and Windows SDK'
-            ' 10.0.19041.0 installed.\nSee go/adtsetup-msvc.'
+            'You must have a compatible MSVC installation or set BAZEL_VC.'
         )
         sys.exit(1)
 
+    bash_candidates = [
+        os.environ.get('BAZEL_SH', ''),
+        r'C:\Program Files\Git\bin\bash.exe',
+        r'C:\Program Files\Git\usr\bin\bash.exe',
+        r'C:\tools\msys64\usr\bin\bash.exe',
+    ]
+    bash_path = next((b for b in bash_candidates if b and os.path.exists(b)), r'C:\tools\msys64\usr\bin\bash.exe')
     define_env(
         env,
         'BAZEL_SH',
-        'C:\\tools\\msys64\\usr\\bin\\bash.exe',
-        '***NOTE***: Bazel for Windows currently hardcodes "C:\\tools\\msys64",'
-        ' but we\n'
-        + 'could not find an installation of msys at this path on your'
-        ' machine.\n'
-        + 'Move your installation there if you already have it or\n'
-        + 'install it there from http://www.msys2.org.\n'
-        + 'Make sure to change the path to C:\\tools\\msys64\n'
-        + '\n'
-        + 'See also: https://github.com/bazelbuild/bazel/issues/2447',
+        bash_path,
+        'Could not find a valid bash installation. Please set BAZEL_SH.',
     )
